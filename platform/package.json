{
  "name": "@codat/platform",
  "version": "7.0.0",
  "author": "Codat",
  "repository": {
    "type": "git",
    "url": "https://github.com/codatio/client-sdk-typescript.git",
    "directory": "platform"
  },
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/make-esm-loadable.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./sdk/models/shared": {
      "types": "./dist/sdk/models/shared/index.d.ts",
      "import": "./dist/esm/sdk/models/shared/index.js",
      "default": "./dist/sdk/models/shared/index.js"
    },
    "./sdk/models/operations": {
      "types": "./dist/sdk/models/operations/index.d.ts",
      "import": "./dist/esm/sdk/models/operations/index.js",
      "default": "./dist/sdk/models/operations/index.js"
    },
    "./sdk/models/errors": {
      "types": "./dist/sdk/models/errors/index.d.ts",
      "import": "./dist/esm/sdk/models/errors/index.js",
      "default": "./dist/sdk/models/errors/index.js"
    },
    "./sdk/types": {
      "types": "./dist/sdk/types/index.d.ts",
      "import": "./dist/esm/sdk/types/index.js",
      "default": "./dist/sdk/types/index.js"
    },
    "./core.js": {
      "types": "./dist/core.d.ts",
      "import": "./dist/esm/core.js",
      "default": "./dist/core.js"
    },
    "./lib/http": {
      "types": "./dist/lib/sdkconfig.d.ts",
      "import": "./dist/esm/lib/sdkconfig.js",
      "default": "./dist/lib/sdkconfig.js"
    },
    "./funcs/*.js": {
      "types": "./dist/funcs/*.d.ts",
      "import": "./dist/esm/funcs/*.js",
      "default": "./dist/funcs/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "sdk/models/shared": [
        "./dist/sdk/models/shared/index.d.ts"
      ],
      "sdk/models/operations": [
        "./dist/sdk/models/operations/index.d.ts"
      ],
      "sdk/models/errors": [
        "./dist/sdk/models/errors/index.d.ts"
      ],
      "sdk/types": [
        "./dist/sdk/types/index.d.ts"
      ],
      "core.js": [
        "./dist/core.d.ts"
      ],
      "lib/http": [
        "./dist/lib/sdkconfig.d.ts"
      ],
      "funcs/*.js": [
        "./dist/funcs/*.d.ts"
      ]
    }
  }
}
