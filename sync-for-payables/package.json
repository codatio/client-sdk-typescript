{
  "name": "@codat/sync-for-payables",
  "version": "9.3.3",
  "author": "Codat",
  "repository": {
    "type": "git",
    "url": "https://github.com/codatio/client-sdk-typescript.git",
    "directory": "sync-for-payables"
  },
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk/models/shared": {
      "types": "./dist/sdk/models/shared/index.d.ts",
      "default": "./dist/sdk/models/shared/index.js"
    },
    "./sdk/models/operations": {
      "types": "./dist/sdk/models/operations/index.d.ts",
      "default": "./dist/sdk/models/operations/index.js"
    },
    "./sdk/models/errors": {
      "types": "./dist/sdk/models/errors/index.d.ts",
      "default": "./dist/sdk/models/errors/index.js"
    },
    "./sdk/types": {
      "types": "./dist/sdk/types/index.d.ts",
      "default": "./dist/sdk/types/index.js"
    },
    "./core.js": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./lib/http": {
      "types": "./dist/lib/sdkconfig.d.ts",
      "default": "./dist/lib/sdkconfig.js"
    },
    "./funcs/*.js": {
      "types": "./dist/funcs/*.d.ts",
      "default": "./dist/funcs/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
