{
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "target": "es2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "typeRoots": [
      "node_modules/@types"
    ],
    "sourceMap": true,
    "declarationMap": true
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
